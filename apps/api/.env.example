# SwitchPilot FastAPI Backend Environment Variables
APP_ENV=development
APP_NAME=SwitchPilot API
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_512_bit_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=switchpilot
POSTGRES_PASSWORD=switchpilot_secret
POSTGRES_DB=switchpilot_db

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Network SSH Protocol Timeouts
SSH_CONNECT_TIMEOUT_SEC=15
SSH_READ_TIMEOUT_SEC=30
